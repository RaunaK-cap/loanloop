# Appwrite (Web SDK + server)
# Create one project at https://cloud.appwrite.io and copy its endpoint + project ID.
# Also add a Web platform for `localhost` and your Vercel domain in the Appwrite console.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=loanloop
NEXT_PUBLIC_APPWRITE_BUCKET_ID=item-images

# Server-only Appwrite API key.
# Scopes needed: Databases, Tables, Columns, Indexes, Rows, Buckets, Files,
# and Users (read + write).
APPWRITE_API_KEY=

# Gemini (AI assistant + embeddings). Optional for the local demo.
# gemini-3.8-flash is the stable default; 2.5 Flash is retired for new projects.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Protects /api/cron/overdue. Vercel Cron sends this as a Bearer token.
CRON_SECRET=

# Public app URL used by `bun run cron`.
APP_URL=http://localhost:3000

# Password for the four seeded Sunshine Apartments accounts.
SEED_PASSWORD="LoanLoop#2026"

# Optional: force the local fixture demo even when Appwrite is configured.
NEXT_PUBLIC_DEMO_MODE=false
